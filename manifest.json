{
  "manifest_version": 3,
  "name": "WhatsApp → Telegram Alert",
  "version": "1.0.0",
  "description": "Sends you a Telegram message whenever a new WhatsApp Web notification arrives.",
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://api.telegram.org/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": "icons/whatsapp.png"
  },
  "icons": {
    "128": "icons/whatsapp.png"
  },
  "options_page": "src/options.html"
}
